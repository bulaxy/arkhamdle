   - Core deduplication function:
     ```typescript
     interface DeduplicateCriteria {
       name?: boolean;
       subname?: boolean;
       pack?: boolean;
       class?: boolean;
       xp?: boolean;
     }
     
     export function deduplicateByEvaluationCriteria(
       cards: TransformedCard[] | TransformedInvestigator[],
       criteria: DeduplicateCriteria
     ): (TransformedCard | TransformedInvestigator)[] {
       const seen = new Set<string>();
       return cards.filter(card => {
         const key = buildKeyFromCriteria(card, criteria);
         if (seen.has(key)) return false;
         seen.add(key);
         return true;
       });
     }
     
     function buildKeyFromCriteria(card: any, criteria: DeduplicateCriteria): string {
       const parts = [];
       if (criteria.name) parts.push(card.name);
       if (criteria.subname) parts.push(card.subname || '');
       if (criteria.pack) parts.push(card.pack_name);
       if (criteria.class) parts.push(card.class?.join(',') || card.faction_code?.[0] || '');
       if (criteria.xp) parts.push(String(card.xp ?? 0));
       return parts.join('|');
     }
     ```
   
